#compdef pdf-vdiff

autoload -U is-at-least

_pdf-vdiff() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'-o+[Target output PDF file path \[default\: <base_stem>_vs_<tailored_stem>_diff.pdf\]]:PATH:_files' \
'--output=[Target output PDF file path \[default\: <base_stem>_vs_<tailored_stem>_diff.pdf\]]:PATH:_files' \
'--theme=[Color palette theme (intellij, github, classic, high-contrast)]:THEME:((intellij\:"Soft IntelliJ-style red/green diff colors (Default)"
github\:"Clean GitHub-style split diff colors"
classic\:"Traditional vibrant red/green diff colors"
high-contrast\:"High-contrast palette for maximum visual accessibility"))' \
'--granularity=[Diff granularity mode (word, line, character)]:GRANULARITY:((word\:"Diff by word tokens (Default)"
line\:"Diff by full lines"
character\:"Diff by individual characters/glyphs"))' \
'--gutter-width=[Spacing in points between left and right pages]:GUTTER_WIDTH:_default' \
'--max-pages=[Maximum page count threshold to prevent unbounded processing]:MAX_PAGES:_default' \
'--generate-completions=[Generate shell completion script to stdout (bash, zsh, fish, elvish, powershell)]:SHELL:(bash elvish fish powershell zsh)' \
'-f[Overwrite destination output file if it already exists]' \
'--force[Overwrite destination output file if it already exists]' \
'--open[Automatically open the generated diff in the system default PDF viewer]' \
'--no-header[Suppress the top header/metadata banner]' \
'-v[Enable verbose structural logging (omits sensitive raw text PII)]' \
'--verbose[Enable verbose structural logging (omits sensitive raw text PII)]' \
'--generate-man[Generate roff man page (Section 1) to stdout]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
'-V[Print version]' \
'--version[Print version]' \
'::base_pdf -- Path to the original / base PDF document:_files' \
'::tailored_pdf -- Path to the modified / tailored PDF document:_files' \
&& ret=0
}

(( $+functions[_pdf-vdiff_commands] )) ||
_pdf-vdiff_commands() {
    local commands; commands=()
    _describe -t commands 'pdf-vdiff commands' commands "$@"
}

if [ "$funcstack[1]" = "_pdf-vdiff" ]; then
    _pdf-vdiff "$@"
else
    compdef _pdf-vdiff pdf-vdiff
fi
